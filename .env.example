# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/nibbler

# ── Text generation: provider routing ─────────────────────────────────────────
# Nibbler talks to one of three interchangeable models through
# app/services/llm/. Switching provider is a variable change + restart; no code
# changes, no new integration.
#
#   single   → call LLM_ACTIVE_PROVIDER and nothing else. Use this to judge one
#              model's output quality without a fallback quietly substituting
#              a different model's work.
#   fallback → walk LLM_FALLBACK_ORDER, stopping at the first response that
#              passes schema + semantic validation.
#
# Subscription tier does NOT affect model choice. Free, trial and premium users
# all get whatever this configuration selects.
LLM_ROUTING_MODE=fallback
LLM_ACTIVE_PROVIDER=luna
LLM_FALLBACK_ORDER=luna,haiku,qwen
LLM_LUNA_ENABLED=true
LLM_HAIKU_ENABLED=true
LLM_QWEN_ENABLED=true
# Seconds a provider stays skipped after proving itself unwell (out of credit,
# 401, unreachable). Process-local — see app/services/llm/circuit.py.
LLM_CIRCUIT_COOLDOWN_SECONDS=120

# ── Luna — OpenAI GPT-5.6 Luna (default provider) ─────────────────────────────
# SEPARATE from OPENAI_API_KEY below, which belongs to the inert image module.
# Setting this key must never switch image generation on.
# Model id must be the explicit `gpt-5.6-luna`: the bare `gpt-5.6` alias routes
# to Sol, a different and pricier model.
# Reasoning effort is capped at `low` (none | minimal | low). Anything higher is
# rejected at startup — reasoning tokens are billed as output.
OPENAI_LLM_API_KEY=sk-proj-your-key-here
OPENAI_LLM_MODEL=gpt-5.6-luna
OPENAI_LLM_REASONING_EFFORT=low
OPENAI_LLM_TIMEOUT_SECONDS=90

# ── Haiku — Anthropic Claude Haiku 4.5 (first fallback) ───────────────────────
# Sonnet is not used. CLAUDE_API_KEY is the legacy name and still works; the
# new name wins when both are set.
ANTHROPIC_LLM_API_KEY=sk-ant-your-key-here
ANTHROPIC_LLM_MODEL=claude-haiku-4-5
ANTHROPIC_LLM_TIMEOUT_SECONDS=120
CLAUDE_API_KEY=

# ── Qwen — self-hosted, OpenAI-compatible (second fallback) ───────────────────
# Railway CANNOT reach a MacBook's localhost or LAN: 127.0.0.1 inside a Railway
# container is the container. In production this must be the public HTTPS
# tunnel URL. See docs/QWEN_LOCAL_SETUP.md for the full setup.
QWEN_BASE_URL=https://qwen.example.com/v1
QWEN_API_KEY=generate-a-long-random-token
QWEN_MODEL=qwen3-14b
QWEN_TIMEOUT_SECONDS=180
# The --ctx-size llama-server was started with. Must be >= 24576. A 15-minute
# Wisdom deck needs ~16,000 tokens (8,000 in + 8,000 reserved out); the minimum
# carries a 1.5x margin because an over-long prompt does not error — llama-server
# drops its START, where the instructions are. Startup validation rejects less.
QWEN_CONTEXT_SIZE=32768

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_CLIENT_ID=your-client-id

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=eu-north-1
S3_BUCKET_NAME=nibbler-user-files

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=nibbler-content
PINECONE_ENVIRONMENT=gcp-starter

# ── Voyage AI (embeddings) ────────────────────────────────────────────────────
# Without a key, embeddings fall back to a deterministic mock (dev only)
VOYAGE_API_KEY=

# ── RevenueCat (subscription sync) ────────────────────────────────────────────
# Webhook secret: the Authorization header value you set in the RC dashboard
# webhook config. Secret API key: RC dashboard → API keys → secret (sk_...).
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_SECRET_API_KEY=

# ── Push Notifications (Expo) ─────────────────────────────────────────────────
# Optional: get from expo.dev → Project → Access Tokens (increases rate limits)
EXPO_ACCESS_TOKEN=

# ── Analytics (Mixpanel) ──────────────────────────────────────────────────────
# Same project token as frontend — mixpanel.com → Project → Settings
MIXPANEL_TOKEN=

# ── Support (bug reports + email) ─────────────────────────────────────────────
# Same Resend account the website contact form uses
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=noreply@getnibbler.com
BUG_REPORT_EMAIL=bug-report@getnibbler.com
BUG_DRIVE_FOLDER_ID=

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=your-secret-key-min-32-chars
FREE_UPLOAD_LIMIT=3
FREE_BITES_PER_DAY=1
PREMIUM_BITES_PER_DAY=3
